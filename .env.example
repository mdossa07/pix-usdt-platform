# Local development — never use live financial keys in this file or frontend.
NODE_ENV=development
PAYMENTS_MODE=mock
# Production must use a public HTTPS origin; HTTP is accepted only in development/test.
APP_URL=http://localhost:3000
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Production builds must receive an explicit HTTPS API URL.
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL / Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pixsplit?schema=public
REDIS_URL=redis://localhost:6379
# Optional Alertmanager overlay. Store the HTTPS webhook URL in a file ignored by Git.
# Set this only when starting with docker-compose.alertmanager.yml.
# ALERTMANAGER_WEBHOOK_URL_FILE=.secrets/alertmanager_webhook_url

# Prometheus scrape endpoint is hidden (404) until a strong bearer token is configured.
# Generate at least 32 random visible ASCII characters and store in the secret manager.
METRICS_BEARER_TOKEN=

# Security. Replace these values locally; generate with a cryptographically secure generator.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
# 32-byte key as 64 hex characters. Example only; generate your own.
PII_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FROM_openssl_rand_hex_32

# Foxbit — deliberately disabled until commercial approval and sandbox credentials.
FOXBIT_API_BASE_URL=https://api.foxbit.com.br/rest/v3
FOXBIT_API_KEY=
FOXBIT_API_SECRET=
FOXBIT_WEBHOOK_SECRET=

# Product policy
PLATFORM_COMMISSION_BPS=200
# Mock-only indicative conversion rate. Never used in sandbox or live mode.
MOCK_USDT_PER_BRL=0.180000
