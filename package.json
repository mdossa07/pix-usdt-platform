{
  "name": "pixsplit-platform",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm --filter @pixsplit/api test",
    "db:generate": "pnpm --filter @pixsplit/api db:generate",
    "db:migrate": "pnpm --filter @pixsplit/api db:migrate",
    "db:migrate:dev": "pnpm --filter @pixsplit/api db:migrate:dev",
    "db:studio": "pnpm --filter @pixsplit/api db:studio",
    "audit:dependencies": "pnpm audit --audit-level moderate",
    "start:api": "pnpm --filter @pixsplit/api start",
    "start:web": "pnpm --filter @pixsplit/web start",
    "db:generate:deploy": "pnpm --filter @pixsplit/api db:generate:deploy",
    "db:migrate:deploy": "pnpm --filter @pixsplit/api db:migrate:deploy"
  },
  "pnpm": {
    "overrides": {
      "fast-jwt": "6.3.7",
      "deepmerge-ts": "8.0.0",
      "effect": "3.22.1"
    }
  }
}
